{
  "manifest_version": 3,
  "name": "Arca by Pixra",
  "version": "0.4.1",
  "description": "Zero-Knowledge, Local-First Password Manager by Pixra (XChaCha20-Poly1305 + Argon2id + WebAuthn PRF)",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "offscreen",
    "activeTab",
    "contextMenus",
    "scripting",
    "notifications"
  ],
  "host_permissions": [],
  "background": {
    "service_worker": "background/index.js",
    "type": "module",
    "scripts": [
      "background/index.js"
    ]
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Arca by Pixra",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; connect-src 'self' https://sync.vaultguard.dev; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "arca@pixra.dev",
      "strict_min_version": "121.0"
    }
  }
}